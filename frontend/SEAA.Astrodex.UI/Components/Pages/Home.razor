@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS

<div class="hero-container">

    <!-- Three.js -->
    <div id="space-scene"></div>

    <!-- Overlay UI -->
    <div class="hero-overlay">

        <img src="images/AstrodexPersonaje.png"
             class="astrobot"
             alt="AstroBot" />

        <h1>SEAA</h1>

        <p>
            Sistema de Exploración y Análisis Astronómico
        </p>

        <div class="hero-buttons">

            <button class="btn-space">
                Explorar
            </button>

            <button class="btn-space">
                Relaciones
            </button>

            <button class="btn-space">
                Rutas
            </button>

        </div>
    </div>
</div>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initSpaceScene");
        }
    }
}