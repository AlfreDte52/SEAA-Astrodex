@page "/"
@using SEAA.Astrodex.UI.Components.Shared
@rendermode InteractiveServer
@inject IJSRuntime JS


<div class="hero-container">

    <!-- Three.js -->
    <div id="space-scene"></div>

    <!-- Overlay UI -->
    <div class="hero-overlay">

        <img src="images/AstrodexPersonaje.png"
             class="astrobot"
             alt="AstroBot" />

        <h1 class="hero-title">
            SEAA · Astrodex
        </h1>

        <p class="hero-subtitle">
            Sistema de Exploración y Análisis Astronómico
        </p>

        <div class="hero-buttons">
            <NavLink href="/explorador" class="btn-space">
                Explorar
            </NavLink>

            <NavLink href="/relaciones" class="btn-space">
                Relaciones
            </NavLink>

            <NavLink href="/rutas" class="btn-space">
                Rutas
            </NavLink>

        </div>
    </div>
</div>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initSpaceScene");
        }
    }
}