@page "/explorador"
@rendermode InteractiveServer

@using SEAA.Astrodex.UI.Models.CuerpoCeleste
@using SEAA.Astrodex.UI.Services

@inject CuerpoCelesteService CuerpoService
@inject NavigationManager NavManager

<div class="explorer-header">

    <h1 class="hero-title">
        Explorador Astronómico
    </h1>

    <p class="hero-subtitle">
        Cuerpos celestes Astrodex API
    </p>

</div>

<div class="explorer-filters">

    <button class="@(tipoActual == "Planet"
                            ? "filter-btn active"
                            : "filter-btn")"
            @onclick='() => CambiarTipo("Planet")'>

        Planetas

    </button>

    <button class="@(tipoActual == "Moon"
                            ? "filter-btn active"
                            : "filter-btn")"
            @onclick='() => CambiarTipo("Moon")'>
        Lunas
    </button>

    <button class="@(tipoActual == "Comet"
                            ? "filter-btn active"
                            : "filter-btn")"
            @onclick='() => CambiarTipo("Comet")'>
        Cometas
    </button>

    <button class="@(tipoActual == "Asteroid"
                            ? "filter-btn active"
                            : "filter-btn")"
            @onclick='() => CambiarTipo("Asteroid")'>
        Asteroides
    </button>

    <button class="filter-btn"
            @onclick='() => CambiarTipo("Star")'>
        Estrellas
    </button>

</div>


@if (cargando)
{
    <p>Cargando cuerpos celestes...</p>
}
else if (!cuerpos.Any())
{
    <p>No se encontraron resultados.</p>
}
else
{
    <div class="explorer-grid">

        @foreach (var cuerpo in cuerpos)
        {
            <div class="space-card clickable-card"
                 @onclick='() => IrDetalle(cuerpo.id)'>

                <h3>
                    @cuerpo.nombre
                </h3>

                <p>
                    Tipo:
                    @cuerpo.tipoCuerpo
                </p>

                <p>
                    Radio:
                    @cuerpo.radioMedio km
                </p>

                <p>
                    Gravedad:
                    @cuerpo.gravedad
                </p>

            </div>
        }

    </div>
}

@code {

    private List<CuerpoCelesteDto>
        cuerpos = [];

    private bool cargando = true;
    private string tipoActual = "Planet";

    private async Task CambiarTipo(string tipo)
    {
        cargando = true;
        tipoActual = tipo;

        cuerpos =
            await CuerpoService
                .ObtenerPorTipoAsync(tipo);

        cargando = false;
    }

    private void IrDetalle(string id)
    {
        NavManager.NavigateTo(
            $"/cuerpo/{id}"
        );
    }

    protected override async Task
        OnInitializedAsync()
    {
        cuerpos =
            await CuerpoService
                .ObtenerPorTipoAsync(
                    "Planet"
                );

        cargando = false;
    }

}